# Copy to `.env` and edit. Every value below is a default that already works - the file
# exists so you can see the whole surface in one place, not because anything is required.
#
#     cp .env.example .env
#
# Pydantic reads `ICU_`-prefixed variables (see src/icu_monitor/config.py). A real
# environment variable always beats the file, which is how the same image serves a laptop,
# a container, and hosted Streamlit without an edit.

# ---------------------------------------------------------------------------- identity
ICU_APP_NAME=ICU Sentinel
ICU_ENVIRONMENT=local              # local | docker | cloud
ICU_DEBUG=false
ICU_LOG_LEVEL=INFO                 # read directly from the environment, not via Settings

# -------------------------------------------------------------------------------- paths
# Set this when the data root is not the repository - a container mounting a volume, say.
# ICU_PROJECT_ROOT=/app
# ICU_DATA_DIR=/app/data
# ICU_ARTIFACTS_DIR=/app/artifacts

# ----------------------------------------------------------------------------- storage
# UNSET (the default) keeps a file-based SQLite ledger at data/icu_monitor.db, so alerts,
# vitals, and acknowledgements survive a restart. The line below just spells that default
# out; you do not need it.
# ICU_DATABASE_URL=sqlite:///data/icu_monitor.db
# Set it to an EMPTY string to run with no persistence at all - everything lives in memory
# for the life of the process and /ready reports the database as "in-memory only" without
# becoming unready.
# ICU_DATABASE_URL=
# Install the driver first when using PostgreSQL: `pip install -e ".[postgres]"`.
# ICU_DATABASE_URL=postgresql+psycopg://icu:icu@localhost:5432/icu
ICU_DB_RETENTION_ROWS=20000

# -------------------------------------------------------------------------------- ward
ICU_BED_COUNT=6                    # 1-24
ICU_VITALS_SOURCE=simulator        # simulator | replay
ICU_SIMULATION_SEED=20260905       # fix the seed and the ward is reproducible
ICU_TICK_SECONDS=2.0               # 0.25-30
ICU_HISTORY_WINDOW=180             # observations retained per bed

# ------------------------------------------------------------------------------ vision
# `auto` picks the best available: a camera if one opens, else a synthetic ward scene;
# YOLO if weights and ultralytics are present, else the NumPy heuristic. Both degrade
# visibly - the UI names the backend in use rather than pretending.
ICU_FRAME_SOURCE=auto              # auto | synthetic | camera | video | off
ICU_DETECTOR=auto                  # auto | yolo | heuristic | off
ICU_CAMERA_INDEX=0
ICU_CAMERA_WIDTH=960
ICU_CAMERA_HEIGHT=540
# ICU_VIDEO_PATH=data/raw/ward.mp4
ICU_YOLO_WEIGHTS=yolov8n.pt
ICU_PERSON_CONFIDENCE=0.45
ICU_FALL_ASPECT_RATIO=1.6          # width/height above which a person reads as horizontal
ICU_FALL_PERSISTENCE_FRAMES=3      # consecutive frames before a fall is called

# ------------------------------------------------------------- scoring and escalation
ICU_NEWS2_MEDIUM_THRESHOLD=5
ICU_NEWS2_HIGH_THRESHOLD=7
ICU_COMPOSITE_MEDIUM_THRESHOLD=40
ICU_COMPOSITE_HIGH_THRESHOLD=65
ICU_COMPOSITE_CRITICAL_THRESHOLD=85

# Channel weights. NEWS2 carries the most because it is the validated instrument; the
# model refines it and vision only ever adds. Weights are normalised over the channels
# that actually reported, so a missing model does not drag every score down.
ICU_WEIGHT_NEWS2=0.40
ICU_WEIGHT_ML=0.45
ICU_WEIGHT_VISION=0.15

# ------------------------------------------------------------------ labels and windows
ICU_LABEL_SOFA_MEDIUM=9
ICU_LABEL_LOS_MEDIUM_DAYS=14
ICU_WINDOW_HOURS=8
ICU_WINDOW_STRIDE_HOURS=4
ICU_MIN_WINDOWS_PER_RECORD=1

# ------------------------------------------------------------------------------ alerts
ICU_ALERT_COOLDOWN_SECONDS=20      # de-duplication: the same condition will not re-fire
ICU_ALERT_MAX_OPEN=200
ICU_AUDIBLE_ALERTS=true            # browser-side only; there is no server-side beep

# --------------------------------------------------------------------------------- api
# Keep local runs private. Docker sets this to 0.0.0.0 inside the container.
ICU_API_HOST=127.0.0.1
ICU_API_PORT=8000
ICU_API_BASE_URL=http://localhost:8000
ICU_CORS_ORIGINS=["*"]             # JSON list; narrow this the moment the API is public
ICU_API_WARMUP_TICKS=30            # ticks run at startup so the first read is not empty

# SECURITY: unset means every /api/v1 route is open. Set it and callers must send
# `X-API-Key: <value>`; /health, /ready and /metrics stay open so an orchestrator can
# still scrape them. Set this before exposing the API beyond localhost.
# ICU_API_KEY=change-me
